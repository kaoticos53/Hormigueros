    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Streaming/PheromoneTileModel.cs" Link="UnityPure/PheromoneTileModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Streaming/ActivationViewModel.cs" Link="UnityPure/ActivationViewModel.cs" />
