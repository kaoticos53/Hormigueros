    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Streaming/WorldPlaneRay.cs" Link="UnityPure/WorldPlaneRay.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Presenter/GameStreamPresenter.cs" Link="UnityPure/GameStreamPresenter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/UI/PoolPickerModel.cs" Link="UnityPure/PoolPickerModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/UI/AntInspectorModel.cs" Link="UnityPure/AntInspectorModel.cs" />
