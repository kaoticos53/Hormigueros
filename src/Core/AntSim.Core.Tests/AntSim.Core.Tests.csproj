<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntSim.Core\AntSim.Core.csproj" />
  </ItemGroup>

  <!-- F4.1: los scripts PUROS del esqueleto Unity (sin UnityEngine) se
       compilan también aquí para verificar el contrato del stream/presets
       headless — cualquier cambio del Core que rompa la UI rompe estos tests. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Streaming/GameStreamParser.cs" Link="UnityPure/GameStreamParser.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Streaming/StreamReader.cs" Link="UnityPure/StreamReader.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../App/AntSim.Unity/Assets/Scripts/Streaming/RepoPathResolver.cs" Link="UnityPure/RepoPathResolver.cs" />
